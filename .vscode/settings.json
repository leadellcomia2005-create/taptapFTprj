{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.workingDirectories": [
    "./client"
  ],
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.env": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.cache": true,
    "**/.agents": true,
    "**/.codex-tools": true,
    "**/.firebase": true,
    "**/.vite": true,
    "**/coverage": true,
    "**/output": true,
    "**/playwright-report": true,
    "**/separated-menu-photos": true,
    "**/test-results": true,
    "**/tmp": true,
    "**/Thumbs.db": true,
    "**/Desktop.ini": true,
    "**/*.bak": true,
    "**/*.log": true,
    "**/*.swp": true,
    "**/*.tmp": true,
    "**/*.7z": true,
    "**/*.rar": true,
    "**/*.zip": true,
    "**/config.yml": true,
    "**/service-account*.json": true
  },
  "search.exclude": {
    "**/.env": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.cache": true,
    "**/.agents": true,
    "**/.codex-tools": true,
    "**/.firebase": true,
    "**/.vite": true,
    "**/coverage": true,
    "**/output": true,
    "**/playwright-report": true,
    "**/separated-menu-photos": true,
    "**/test-results": true,
    "**/tmp": true,
    "**/*.bak": true,
    "**/*.log": true,
    "**/*.swp": true,
    "**/*.tmp": true,
    "**/service-account*.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.agents/**": true,
    "**/.codex-tools/**": true,
    "**/.firebase/**": true,
    "**/playwright-report/**": true,
    "**/separated-menu-photos/**": true,
    "**/test-results/**": true,
    "**/tmp/**": true
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  "npm.packageManager": "npm"
}
