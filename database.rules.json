{
  "rules": {
    ".read": false,
    ".write": false,
    "public": {
      "menu": {
        ".read": true,
        ".write": "auth != null && auth.token.role == 'owner'"
      },
      "store": {
        ".read": true,
        ".write": "auth != null && auth.token.role == 'owner'"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.role == 'owner')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.role == 'owner')",
        ".validate": "auth.token.role == 'owner' || newData.child('role').val() == (data.exists() ? data.child('role').val() : 'customer')"
      }
    },
    "orders": {
      "$orderId": {
        ".read": "auth != null && (data.child('customerId').val() == auth.uid || data.child('riderId').val() == auth.uid || auth.token.role == 'owner' || auth.token.role == 'staff')",
        ".write": "auth != null && (auth.token.role == 'owner' || auth.token.role == 'staff' || auth.token.role == 'rider' || (!data.exists() && newData.child('customerId').val() == auth.uid))"
      }
    },
    "inventory": {
      ".read": "auth != null && (auth.token.role == 'owner' || auth.token.role == 'staff')",
      ".write": "auth != null && (auth.token.role == 'owner' || auth.token.role == 'staff')"
    },
    "riderLocations": {
      "$riderId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $riderId || auth.token.role == 'owner' || auth.token.role == 'staff')"
      }
    },
    "messages": {
      "$orderId": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && newData.child('senderId').val() == auth.uid",
          ".validate": "newData.hasChildren(['text', 'senderId', 'senderName', 'senderRole', 'createdAt'])"
        }
      }
    },
    "auditLogs": {
      ".read": "auth != null && auth.token.role == 'owner'",
      ".write": "auth != null"
    },
    "shiftLogs": {
      ".read": "auth != null && (auth.token.role == 'owner' || auth.token.role == 'staff')",
      ".write": "auth != null && (auth.token.role == 'owner' || auth.token.role == 'staff')"
    },
    "reviews": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null && newData.child('customerId').val() == auth.uid && root.child('orders').child($orderId).child('customerId').val() == auth.uid",
        ".validate": "newData.hasChildren(['orderId', 'customerId', 'customerName', 'rating', 'createdAt']) && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5"
      }
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
