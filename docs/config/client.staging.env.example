# Copy to an ignored client environment file for staging only.
# Never put server credentials or production Firebase identifiers here.
VITE_FIREBASE_API_KEY=replace-with-staging-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=taptap-staging.example.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://taptap-staging.example.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=taptap-staging-example
VITE_FIREBASE_STORAGE_BUCKET=taptap-staging.example.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-staging-sender-id
VITE_FIREBASE_APP_ID=replace-with-staging-app-id
VITE_FIREBASE_VAPID_KEY=replace-with-staging-web-push-public-key
VITE_FIREBASE_MEASUREMENT_ID=

VITE_API_BASE_URL=https://staging-api.example.invalid/api
VITE_SOCKET_URL=https://staging-api.example.invalid
VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_DEMO_MODE=false
VITE_DISABLE_FIREBASE=false
VITE_ENABLE_FIREBASE_STORAGE=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_ENABLE_PWA=true
VITE_TURNSTILE_SITE_KEY=

VITE_STORE_NAME=TapTap Foodtrip Staging
VITE_STORE_ADDRESS=Replace with the staging display address
VITE_STORE_LATITUDE=14.4509229
VITE_STORE_LONGITUDE=120.9764514
