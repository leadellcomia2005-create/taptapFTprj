# Load these values through the staging host or secret manager.
# Do not commit a populated copy of this file.
PORT=8080
CLIENT_ORIGIN=https://staging.example.invalid
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\ignored-staging-service-account.json
FIREBASE_DATABASE_URL=https://taptap-staging.example.firebasedatabase.app
FIREBASE_STORAGE_BUCKET=taptap-staging.example.firebasestorage.app
FIREBASE_WEB_API_KEY=
TWO_FACTOR_ENCRYPTION_KEY=

# Deferred integrations remain disabled in staging and production.
ENABLE_OPENAI=false
ENABLE_TWILIO=false
ENABLE_PAYMONGO=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DIALOGFLOW_PROJECT_ID=
DIALOGFLOW_LANGUAGE_CODE=en
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GMAIL_USER=
GMAIL_APP_PASSWORD=
TURNSTILE_SECRET_KEY=
