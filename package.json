{
  "name": "taptap-foodtrip-integrated",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server && npm install --prefix functions",
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy --only database",
    "deploy:paid-services": "npm run build && firebase deploy",
    "test": "npm run typecheck --prefix client && npm run lint --prefix client && npm run test --prefix server",
    "test:rules": "firebase emulators:exec --project demo-taptap-foodtrip --only database \"node test/database.rules.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "clean:workspace": "node scripts/clean-workspace.mjs",
    "clean:workspace:apply": "node scripts/clean-workspace.mjs --apply"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.1",
    "firebase-tools": "^15.23.0"
  },
  "dependencies": {
    "openai": "^6.44.0"
  }
}
