PORT=8080
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Use this protected secret instead of a file path on hosts such as Render.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_DATABASE_URL=https://taptapftprj-leadell-2026-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_STORAGE_BUCKET=taptapftprj-leadell-2026.firebasestorage.app
FIREBASE_WEB_API_KEY=

TWO_FACTOR_ENCRYPTION_KEY=

ENABLE_OPENAI=false
ENABLE_GROQ=false
ENABLE_TWILIO=false
ENABLE_PAYMONGO=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

DIALOGFLOW_PROJECT_ID=
DIALOGFLOW_LANGUAGE_CODE=en

PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

GMAIL_USER=
GMAIL_APP_PASSWORD=

# HTTPS email delivery for hosted environments where SMTP is unavailable.
ENABLE_RESEND=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=TapTap Foodtrip <security@mail.taptapfoodtrip.xyz>

TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=false
TURNSTILE_EXPECTED_ACTION=customer_registration
# Optional comma-separated override. Defaults to CLIENT_ORIGIN hostnames.
TURNSTILE_ALLOWED_HOSTNAMES=

# The website registration session lasts 3 minutes. Abandoned unverified
# accounts are retained longer so a slow customer is not deleted immediately.
REGISTRATION_VERIFICATION_TTL_SECONDS=180
REGISTRATION_ABANDONED_TTL_SECONDS=86400
REGISTRATION_RESEND_COOLDOWN_SECONDS=60
REGISTRATION_RESEND_DAILY_LIMIT=5
REGISTRATION_CLEANUP_INTERVAL_SECONDS=15
AI_INSIGHT_RATE_LIMIT=5
AI_INSIGHT_RATE_WINDOW_SECONDS=300
AI_INSIGHT_CACHE_TTL_SECONDS=300
